/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model bank_statement_rows {
  id                        String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bank_statement_batch_id   String                      @db.Uuid
  row_no                    Int
  transaction_date          DateTime                    @db.Timestamptz(6)
  bank_reference            String?                     @db.VarChar(150)
  description               String?
  amount_in                 Decimal                     @default(0) @db.Decimal(20, 2)
  amount_out                Decimal                     @default(0) @db.Decimal(20, 2)
  balance_after             Decimal?                    @db.Decimal(20, 2)
  matched_bank_movement_id  String?                     @db.Uuid
  match_status              reconciliation_item_status  @default(MISSING_IN_SYSTEM)
