  bank_balance_movements    bank_balance_movements?     @relation(fields: [matched_bank_movement_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([bank_statement_batch_id, row_no], map: "uq_bank_statement_row_no")
  @@index([bank_reference], map: "idx_bank_statement_rows_reference")
}

model banks {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code          String          @unique @db.VarChar(50)
  name          String          @db.VarChar(255)
  status        record_status   @default(ACTIVE)
  bank_accounts bank_accounts[]
}

model branch_daily_summaries {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branch_id             String   @db.Uuid
  business_date         DateTime @db.Date
  shift_count           Int      @default(0)
  transaction_count     Int      @default(0)
  transaction_value_vnd Decimal  @default(0) @db.Decimal(20, 2)
  cash_value_vnd        Decimal  @default(0) @db.Decimal(20, 2)
  bank_value_vnd        Decimal  @default(0) @db.Decimal(20, 2)
  debt_value_vnd        Decimal  @default(0) @db.Decimal(20, 2)
  variance_vnd          Decimal  @default(0) @db.Decimal(20, 2)
  calculated_at         DateTime @default(now()) @db.Timestamptz(6)
  branches              Branch   @relation(fields: [branch_id], references: [id], onUpdate: NoAction)

  @@unique([branch_id, business_date], map: "uq_branch_daily_summary")
}

model business_days {
  id                                             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branch_id                                      String?             @db.Uuid
  business_date                                  DateTime            @db.Date
  status                                         business_day_status @default(OPEN)
  opened_at                                      DateTime            @default(now()) @db.Timestamptz(6)
  closed_at                                      DateTime?           @db.Timestamptz(6)
  closed_by_user_id                              String?             @db.Uuid
  reopened_at                                    DateTime?           @db.Timestamptz(6)
  reopened_by_user_id                            String?             @db.Uuid
  note                                           String?
  branches                                       Branch?             @relation(fields: [branch_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  users_business_days_closed_by_user_idTousers   User?               @relation("business_days_closed_by_user_idTousers", fields: [closed_by_user_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  users_business_days_reopened_by_user_idTousers User?               @relation("business_days_reopened_by_user_idTousers", fields: [reopened_by_user_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  day_closing_runs                               day_closing_runs[]

  @@unique([branch_id, business_date], map: "uq_business_day_branch")
  @@index([business_date, status], map: "idx_business_days_date_status")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model cash_count_lines {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
