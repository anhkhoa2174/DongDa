generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Branch {
  id                                                            String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id                                                    String                        @db.Uuid
  code                                                          String                        @db.VarChar(50)
  name                                                          String                        @db.VarChar(255)
  type                                                          branch_type
  status                                                        record_status                 @default(ACTIVE)
  address                                                       String?
  phone                                                         String?                       @db.VarChar(30)
  created_at                                                    DateTime                      @default(now()) @db.Timestamptz(6)
  updated_at                                                    DateTime                      @default(now()) @db.Timestamptz(6)
  bank_accounts                                                 bank_accounts[]
  bank_balance_movements                                        bank_balance_movements[]
  branch_daily_summaries                                        branch_daily_summaries[]
  companies                                                     companies                     @relation(fields: [company_id], references: [id], onUpdate: NoAction)
  business_days                                                 business_days[]
  cash_counts                                                   cash_counts[]
  cash_movements                                                cash_movements[]
  customer_transactions                                         customer_transactions[]
  day_closing_runs                                              day_closing_runs[]
  debt_accounts                                                 debt_accounts[]
  debt_movements                                                debt_movements[]
  employee_branch_assignments                                   employee_branch_assignments[]
  employees                                                     employees[]
  fund_accounts                                                 fund_accounts[]
  fund_transfers_fund_transfers_destination_branch_idTobranches fund_transfers[]              @relation("fund_transfers_destination_branch_idTobranches")
  fund_transfers_fund_transfers_source_branch_idTobranches      fund_transfers[]              @relation("fund_transfers_source_branch_idTobranches")
  journal_batches                                               journal_batches[]
  journal_rows                                                  journal_rows[]
  journal_upload_files                                          journal_upload_files[]
  ledger_entries                                                ledger_entries[]
  notifications                                                 notifications[]
  reconciliation_adjustments                                    reconciliation_adjustments[]
  reconciliation_items                                          reconciliation_items[]
  reconciliation_runs                                           reconciliation_runs[]
  shifts                                                        shifts[]

  @@unique([company_id, code], map: "uq_branches_company_code")
  @@index([company_id], map: "idx_branches_company_id")
  @@index([type], map: "idx_branches_type")
  @@map("branches")
}

model User {
  id                                                                               String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_id                                                                      String                       @unique @db.Uuid
  username                                                                         String                       @unique @db.VarChar(100)
  password_hash                                                                    String
  status                                                                           user_status                  @default(ACTIVE)
  two_factor_enabled                                                               Boolean                      @default(false)
  must_change_password                                                             Boolean                      @default(true)
  failed_login_count                                                               Int                          @default(0)
  locked_until                                                                     DateTime?                    @db.Timestamptz(6)
  last_login_at                                                                    DateTime?                    @db.Timestamptz(6)
  created_at                                                                       DateTime                     @default(now()) @db.Timestamptz(6)
  updated_at                                                                       DateTime                     @default(now()) @db.Timestamptz(6)
  approval_actions                                                                 approval_actions[]
  approval_requests                                                                approval_requests[]
  approval_steps_approval_steps_acted_by_user_idTousers                            approval_steps[]             @relation("approval_steps_acted_by_user_idTousers")
  approval_steps_approval_steps_assigned_user_idTousers                            approval_steps[]             @relation("approval_steps_assigned_user_idTousers")
  audit_logs                                                                       audit_logs[]
  bank_balance_movements_bank_balance_movements_approved_by_user_idTousers         bank_balance_movements[]     @relation("bank_balance_movements_approved_by_user_idTousers")
  bank_balance_movements_bank_balance_movements_created_by_user_idTousers          bank_balance_movements[]     @relation("bank_balance_movements_created_by_user_idTousers")
  bank_reconciliation_items                                                        bank_reconciliation_items[]
  bank_statement_batches_bank_statement_batches_approved_by_user_idTousers         bank_statement_batches[]     @relation("bank_statement_batches_approved_by_user_idTousers")
  bank_statement_batches_bank_statement_batches_uploaded_by_user_idTousers         bank_statement_batches[]     @relation("bank_statement_batches_uploaded_by_user_idTousers")
  business_days_business_days_closed_by_user_idTousers                             business_days[]              @relation("business_days_closed_by_user_idTousers")
  business_days_business_days_reopened_by_user_idTousers                           business_days[]              @relation("business_days_reopened_by_user_idTousers")
  cash_counts_cash_counts_approved_by_user_idTousers                               cash_counts[]                @relation("cash_counts_approved_by_user_idTousers")
  cash_counts_cash_counts_counted_by_user_idTousers                                cash_counts[]                @relation("cash_counts_counted_by_user_idTousers")
  cash_movements_cash_movements_approved_by_user_idTousers                         cash_movements[]             @relation("cash_movements_approved_by_user_idTousers")
  cash_movements_cash_movements_created_by_user_idTousers                          cash_movements[]             @relation("cash_movements_created_by_user_idTousers")
  customer_risk_flags_customer_risk_flags_created_by_user_idTousers                customer_risk_flags[]        @relation("customer_risk_flags_created_by_user_idTousers")
  customer_risk_flags_customer_risk_flags_resolved_by_user_idTousers               customer_risk_flags[]        @relation("customer_risk_flags_resolved_by_user_idTousers")
  customer_transactions_customer_transactions_created_by_user_idTousers            customer_transactions[]      @relation("customer_transactions_created_by_user_idTousers")
  customer_transactions_customer_transactions_voided_by_user_idTousers             customer_transactions[]      @relation("customer_transactions_voided_by_user_idTousers")
  day_closing_runs_day_closing_runs_approved_by_user_idTousers                     day_closing_runs[]           @relation("day_closing_runs_approved_by_user_idTousers")
  day_closing_runs_day_closing_runs_created_by_user_idTousers                      day_closing_runs[]           @relation("day_closing_runs_created_by_user_idTousers")
  debt_movements_debt_movements_approved_by_user_idTousers                         debt_movements[]             @relation("debt_movements_approved_by_user_idTousers")
  debt_movements_debt_movements_created_by_user_idTousers                          debt_movements[]             @relation("debt_movements_created_by_user_idTousers")
  exchange_rates_exchange_rates_approved_by_user_idTousers                         exchange_rates[]             @relation("exchange_rates_approved_by_user_idTousers")
  exchange_rates_exchange_rates_created_by_user_idTousers                          exchange_rates[]             @relation("exchange_rates_created_by_user_idTousers")
  fund_transfers_fund_transfers_approved_by_user_idTousers                         fund_transfers[]             @relation("fund_transfers_approved_by_user_idTousers")
  fund_transfers_fund_transfers_confirmed_by_user_idTousers                        fund_transfers[]             @relation("fund_transfers_confirmed_by_user_idTousers")
  fund_transfers_fund_transfers_created_by_user_idTousers                          fund_transfers[]             @relation("fund_transfers_created_by_user_idTousers")
  journal_batches                                                                  journal_batches[]
  journal_upload_files                                                             journal_upload_files[]
  ledger_entries_ledger_entries_approved_by_user_idTousers                         ledger_entries[]             @relation("ledger_entries_approved_by_user_idTousers")
  ledger_entries_ledger_entries_created_by_user_idTousers                          ledger_entries[]             @relation("ledger_entries_created_by_user_idTousers")
  notifications                                                                    notifications[]
  reconciliation_adjustments_reconciliation_adjustments_approved_by_user_idTousers reconciliation_adjustments[] @relation("reconciliation_adjustments_approved_by_user_idTousers")
  reconciliation_adjustments_reconciliation_adjustments_created_by_user_idTousers  reconciliation_adjustments[] @relation("reconciliation_adjustments_created_by_user_idTousers")
  reconciliation_items                                                             reconciliation_items[]
  reconciliation_runs_reconciliation_runs_approved_by_user_idTousers               reconciliation_runs[]        @relation("reconciliation_runs_approved_by_user_idTousers")
  reconciliation_runs_reconciliation_runs_created_by_user_idTousers                reconciliation_runs[]        @relation("reconciliation_runs_created_by_user_idTousers")
  reconciliation_runs_reconciliation_runs_reviewed_by_user_idTousers               reconciliation_runs[]        @relation("reconciliation_runs_reviewed_by_user_idTousers")
  shifts_shifts_approved_by_user_idTousers                                         shifts[]                     @relation("shifts_approved_by_user_idTousers")
  shifts_shifts_closed_by_user_idTousers                                           shifts[]                     @relation("shifts_closed_by_user_idTousers")
  shifts_shifts_opened_by_user_idTousers                                           shifts[]                     @relation("shifts_opened_by_user_idTousers")
  shifts_shifts_reviewed_by_user_idTousers                                         shifts[]                     @relation("shifts_reviewed_by_user_idTousers")
  user_roles                                                                       user_roles[]
  employees                                                                        employees                    @relation(fields: [employee_id], references: [id], onUpdate: NoAction)

  @@index([employee_id], map: "idx_users_employee_id")
  @@index([status], map: "idx_users_status")
  @@map("users")
}

model approval_actions {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  approval_request_id String            @db.Uuid
  approval_step_id    String?           @db.Uuid
  action              approval_action
  acted_by_user_id    String            @db.Uuid
  note                String?
  acted_at            DateTime          @default(now()) @db.Timestamptz(6)
  users               User              @relation(fields: [acted_by_user_id], references: [id], onUpdate: NoAction)
  approval_requests   approval_requests @relation(fields: [approval_request_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  approval_steps      approval_steps?   @relation(fields: [approval_step_id], references: [id], onUpdate: NoAction)
}

model approval_requests {
  id                   String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entity_type          String             @db.VarChar(100)
  entity_id            String             @db.Uuid
  requested_by_user_id String             @db.Uuid
  status               approval_status    @default(PENDING)
  requested_at         DateTime           @default(now()) @db.Timestamptz(6)
  completed_at         DateTime?          @db.Timestamptz(6)
  note                 String?
  payload              Json               @default("{}")
  approval_actions     approval_actions[]
  users                User               @relation(fields: [requested_by_user_id], references: [id], onUpdate: NoAction)
  approval_steps       approval_steps[]

  @@index([status, requested_at(sort: Desc)], map: "idx_approval_requests_status")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model approval_steps {
  id                                           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  approval_request_id                          String             @db.Uuid
  step_no                                      Int
  required_role_code                           String?            @db.VarChar(50)
  assigned_user_id                             String?            @db.Uuid
  status                                       approval_status    @default(PENDING)
  acted_by_user_id                             String?            @db.Uuid
  acted_at                                     DateTime?          @db.Timestamptz(6)
  note                                         String?
  approval_actions                             approval_actions[]
  users_approval_steps_acted_by_user_idTousers User?              @relation("approval_steps_acted_by_user_idTousers", fields: [acted_by_user_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  approval_requests                            approval_requests  @relation(fields: [approval_request_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_approval_steps_assigned_user_idTousers User?              @relation("approval_steps_assigned_user_idTousers", fields: [assigned_user_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  roles                                        roles?             @relation(fields: [required_role_code], references: [code], onDelete: Restrict, onUpdate: NoAction)

  @@unique([approval_request_id, step_no], map: "uq_approval_step_no")
}

model audit_logs {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String?  @db.Uuid
  action      String   @db.VarChar(100)
  entity_type String   @db.VarChar(100)
  entity_id   String?  @db.Uuid
  before_data Json?
  after_data  Json?
  ip_address  String?  @db.Inet
  user_agent  String?
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  users       User?    @relation(fields: [user_id], references: [id], onUpdate: NoAction)

  @@index([entity_type, entity_id], map: "idx_audit_logs_entity")
  @@index([user_id, created_at(sort: Desc)], map: "idx_audit_logs_user")
}

model bank_accounts {
  id                     String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branch_id              String                   @db.Uuid
  bank_id                String                   @db.Uuid
  account_no             String                   @db.VarChar(100)
  account_name           String                   @db.VarChar(255)
  currency_code          currency_code
  opening_balance        Decimal                  @default(0) @db.Decimal(20, 2)
  current_balance        Decimal                  @default(0) @db.Decimal(20, 2)
  available_balance      Decimal                  @default(0) @db.Decimal(20, 2)
  status                 record_status            @default(ACTIVE)
  created_at             DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at             DateTime                 @default(now()) @db.Timestamptz(6)
  banks                  banks                    @relation(fields: [bank_id], references: [id], onUpdate: NoAction)
  branches               Branch                   @relation(fields: [branch_id], references: [id], onUpdate: NoAction)
  bank_balance_movements bank_balance_movements[]
  bank_balance_snapshots bank_balance_snapshots[]
  bank_statement_batches bank_statement_batches[]
  fund_accounts          fund_accounts[]

  @@unique([bank_id, account_no], map: "uq_bank_account_no")
  @@index([bank_id], map: "idx_bank_accounts_bank")
  @@index([branch_id], map: "idx_bank_accounts_branch")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model bank_balance_movements {
  id                                                      String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  movement_no                                             String                      @unique @db.VarChar(100)
  bank_account_id                                         String                      @db.Uuid
  branch_id                                               String                      @db.Uuid
  movement_type                                           bank_movement_type
  business_date                                           DateTime                    @db.Date
  occurred_at                                             DateTime                    @default(now()) @db.Timestamptz(6)
  amount                                                  Decimal                     @db.Decimal(20, 2)
  currency_code                                           currency_code
  balance_before                                          Decimal                     @db.Decimal(20, 2)
  balance_after                                           Decimal                     @db.Decimal(20, 2)
  bank_reference                                          String?                     @db.VarChar(150)
  description                                             String?
  status                                                  workflow_status             @default(DRAFT)
  created_by_user_id                                      String                      @db.Uuid
  approved_by_user_id                                     String?                     @db.Uuid
  posted_at                                               DateTime?                   @db.Timestamptz(6)
  created_at                                              DateTime                    @default(now()) @db.Timestamptz(6)
  updated_at                                              DateTime                    @default(now()) @db.Timestamptz(6)
  users_bank_balance_movements_approved_by_user_idTousers User?                       @relation("bank_balance_movements_approved_by_user_idTousers", fields: [approved_by_user_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  bank_accounts                                           bank_accounts               @relation(fields: [bank_account_id], references: [id], onUpdate: NoAction)
  branches                                                Branch                      @relation(fields: [branch_id], references: [id], onUpdate: NoAction)
  users_bank_balance_movements_created_by_user_idTousers  User                        @relation("bank_balance_movements_created_by_user_idTousers", fields: [created_by_user_id], references: [id], onUpdate: NoAction)
  bank_reconciliation_items                               bank_reconciliation_items[]
  bank_statement_rows                                     bank_statement_rows[]

  @@unique([bank_account_id, bank_reference], map: "uq_bank_movement_reference")
  @@index([bank_account_id, occurred_at(sort: Desc)], map: "idx_bank_movements_account_date")
  @@index([branch_id, business_date], map: "idx_bank_movements_branch_date")
}

model bank_balance_snapshots {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bank_account_id String        @db.Uuid
  business_date   DateTime      @db.Date
  opening_balance Decimal       @default(0) @db.Decimal(20, 2)
  total_in        Decimal       @default(0) @db.Decimal(20, 2)
  total_out       Decimal       @default(0) @db.Decimal(20, 2)
  closing_balance Decimal       @default(0) @db.Decimal(20, 2)
  calculated_at   DateTime      @default(now()) @db.Timestamptz(6)
  bank_accounts   bank_accounts @relation(fields: [bank_account_id], references: [id], onUpdate: NoAction)

  @@unique([bank_account_id, business_date], map: "uq_bank_balance_snapshot")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model bank_reconciliation_items {
  id                      String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bank_statement_batch_id String                     @db.Uuid
  bank_statement_row_id   String?                    @db.Uuid
  bank_movement_id        String?                    @db.Uuid
  amount_system           Decimal                    @default(0) @db.Decimal(20, 2)
  amount_statement        Decimal                    @default(0) @db.Decimal(20, 2)
  variance_amount         Decimal                    @default(0) @db.Decimal(20, 2)
  status                  reconciliation_item_status
  note                    String?
  resolved_by_user_id     String?                    @db.Uuid
  resolved_at             DateTime?                  @db.Timestamptz(6)
  created_at              DateTime                   @default(now()) @db.Timestamptz(6)
  bank_balance_movements  bank_balance_movements?    @relation(fields: [bank_movement_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  bank_statement_batches  bank_statement_batches     @relation(fields: [bank_statement_batch_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  bank_statement_rows     bank_statement_rows?       @relation(fields: [bank_statement_row_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  users                   User?                      @relation(fields: [resolved_by_user_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
