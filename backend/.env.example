# Application
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173    # CORS allowed origin

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/dongda_db?schema=public"

# JWT
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_EXPIRES_IN=30m
JWT_REFRESH_SECRET=your-refresh-secret-key-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# Session timeout (phút) — yêu cầu NF1
SESSION_TIMEOUT_MINUTES=30

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=20

# Rate Limit (NF1)
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100

# Thresholds giao dịch lớn (F3.5) — có thể override qua DB config
LARGE_TX_USD_THRESHOLD=5000
LARGE_TX_VND_THRESHOLD=100000000

# External Exchange Rate APIs
VCB_API_URL=https://www.vietcombank.com.vn/api/exchangerates
EXCHANGE_RATE_HOST_URL=https://api.exchangerate.host/latest

# Gemini OCR bảng tỷ giá (API key chỉ đặt ở backend)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
