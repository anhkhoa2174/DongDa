# dongda.info.vn: tự xin SSL Let's Encrypt khi DNS đã trỏ về VPS.
# Khối :80 để vẫn vào được bằng IP khi chưa có DNS.
# Bản TEST (stack dongda-test, mạng ngoài dongda-test_default)
test.dongda.info.vn {
	reverse_proxy dongda-test-caddy-1:80
}

dongda.info.vn {
	encode gzip
	handle /api/* {
		reverse_proxy backend:3000
	}
	handle {
		root * /srv/www
		try_files {path} /index.html
		file_server
	}
}

:80 {
	encode gzip
	handle /api/* {
		reverse_proxy backend:3000
	}
	handle {
		root * /srv/www
		try_files {path} /index.html
		file_server
	}
}
